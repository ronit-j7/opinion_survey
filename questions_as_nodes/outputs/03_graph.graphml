    <node id="T01">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Artificial Intelligence will improve society more than it will create problems.</data>
      <data key="d3">91</data>
    </node>
    <node id="T02">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Generative AI tools should be allowed as learning aids in higher education.</data>
      <data key="d3">91</data>
    </node>
    <node id="T03">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Students should disclose the use of AI in assignments and reports.</data>
      <data key="d3">89</data>
    </node>
    <node id="T04">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Every engineering student should receive formal education in AI.</data>
      <data key="d3">91</data>
    </node>
    <node id="T05">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Artificial Intelligence will significantly accelerate scientific discovery.</data>
      <data key="d3">91</data>
    </node>
    <node id="T06">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Most repetitive jobs will eventually be replaced by intelligent automation.</data>
      <data key="d3">91</data>
    </node>
    <node id="T07">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Robots should replace humans in hazardous occupations whenever possible.</data>
      <data key="d3">91</data>
    </node>
    <node id="T08">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">AI-assisted diagnosis should become routine in healthcare.</data>
      <data key="d3">90</data>
    </node>
    <node id="T09">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Autonomous vehicles will ultimately make transportation safer.</data>
      <data key="d3">90</data>
    </node>
    <node id="T10">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Protection of personal data is more important than technological convenience.</data>
      <data key="d3">91</data>
    </node>
    <node id="T11">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Technology companies should explain how recommendation algorithms work.</data>
      <data key="d3">89</data>
    </node>
    <node id="T12">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Governments should introduce stricter regulations for Artificial Intelligence.</data>
      <data key="d3">90</data>
    </node>
    <node id="T13">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Cybersecurity deserves greater investment than the development of new digital technologies.</data>
      <data key="d3">89</data>
    </node>
    <node id="T14">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Social media algorithms contribute to opinion polarization.</data>
      <data key="d3">90</data>
    </node>
    <node id="T15">
      <data key="d0">T</data>
      <data key="d1">Technology</data>
      <data key="d2">Society will increasingly depend on AI-assisted decision making.</data>
      <data key="d3">90</data>
    </node>
    <node id="E01">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Project-based learning develops deeper understanding than examination-oriented learning.</data>
      <data key="d3">87</data>
    </node>
    <node id="E02">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Traditional written examinations accurately measure a student's knowledge.</data>
      <data key="d3">87</data>
    </node>
    <node id="E03">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Class attendance should be compulsory for all courses.</data>
      <data key="d3">87</data>
    </node>
    <node id="E04">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">High-quality online learning can effectively complement classroom teaching.</data>
      <data key="d3">87</data>
    </node>
    <node id="E05">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Students should be encouraged to take courses outside their primary discipline.</data>
      <data key="d3">85</data>
    </node>
    <node id="E06">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Every undergraduate student should participate in at least one research project.</data>
      <data key="d3">86</data>
    </node>
    <node id="E07">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Publishing research before graduation should be encouraged, but not mandatory.</data>
      <data key="d3">87</data>
    </node>
    <node id="E08">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Maintaining academic honesty is more important than obtaining high grades.</data>
      <data key="d3">85</data>
    </node>
    <node id="E09">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Collaborative learning is generally more effective than individual learning.</data>
      <data key="d3">86</data>
    </node>
    <node id="E10">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Universities should prioritize innovation and problem-solving over rote learning.</data>
      <data key="d3">87</data>
    </node>
    <node id="E11">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">University curricula should be updated more frequently to match emerging technologies.</data>
      <data key="d3">87</data>
    </node>
    <node id="E12">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Artificial intelligence should be integrated into teaching and personalized learning.</data>
      <data key="d3">87</data>
    </node>
    <node id="E13">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Universities should invest more resources in research than in expanding infrastructure.</data>
      <data key="d3">85</data>
    </node>
    <node id="E14">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Strong collaborations between universities and industry improve student education.</data>
      <data key="d3">87</data>
    </node>
    <node id="E15">
      <data key="d0">E</data>
      <data key="d1">Education</data>
      <data key="d2">Continuous learning and skill development are essential throughout one's career.</data>
      <data key="d3">87</data>
    </node>
    <node id="S01">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Every individual has a responsibility to contribute positively to society.</data>
      <data key="d3">86</data>
    </node>
    <node id="S02">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Universities should encourage students to participate in community service activities.</data>
      <data key="d3">87</data>
    </node>
    <node id="S03">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">New technologies should be evaluated for their societal impact before widespread deployment.</data>
      <data key="d3">87</data>
    </node>
    <node id="S04">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Technology companies should be accountable for unethical use of their platforms.</data>
      <data key="d3">87</data>
    </node>
    <node id="S05">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Individuals should have greater control over how their personal data are collected and used.</data>
      <data key="d3">87</data>
    </node>
    <node id="S06">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Combating online misinformation requires shared responsibility among users, platforms, and governments.</data>
      <data key="d3">87</data>
    </node>
    <node id="S07">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Equal opportunities should be prioritized regardless of a person's background.</data>
      <data key="d3">86</data>
    </node>
    <node id="S08">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Diverse teams generally make better decisions than homogeneous teams.</data>
      <data key="d3">86</data>
    </node>
    <node id="S09">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Universities should promote an inclusive environment where different viewpoints can be discussed respectfully.</data>
      <data key="d3">85</data>
    </node>
    <node id="S10">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Scientific evidence should play an important role in public policy decisions.</data>
      <data key="d3">84</data>
    </node>
    <node id="S11">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">People should be free to express differing opinions as long as they do not promote harm or discrimination.</data>
      <data key="d3">87</data>
    </node>
    <node id="S12">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Young people should actively participate in addressing societal challenges.</data>
      <data key="d3">86</data>
    </node>
    <node id="S13">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Critical evaluation of online information should be taught as a core educational skill.</data>
      <data key="d3">87</data>
    </node>
    <node id="S14">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Leaders should prioritize ethical decision-making even when it reduces short-term gains.</data>
      <data key="d3">84</data>
    </node>
    <node id="S15">
      <data key="d0">S</data>
      <data key="d1">Society</data>
      <data key="d2">Building public trust is essential for responsible adoption of emerging technologies.</data>
      <data key="d3">86</data>
    </node>
    <node id="V01">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Climate change requires immediate global action.</data>
      <data key="d3">85</data>
    </node>
    <node id="V02">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Governments should prioritize investment in renewable energy over fossil fuels.</data>
      <data key="d3">85</data>
    </node>
    <node id="V03">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Individuals should actively reduce their personal energy consumption.</data>
      <data key="d3">86</data>
    </node>
    <node id="V04">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Public transportation and non-motorized transport should be promoted even if they require additional public investment.</data>
      <data key="d3">86</data>
    </node>
    <node id="V05">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Single-use plastics should be significantly restricted.</data>
      <data key="d3">86</data>
    </node>
    <node id="V06">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Water conservation should be a priority in households, institutions, and industries.</data>
      <data key="d3">84</data>
    </node>
    <node id="V07">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Protecting biodiversity is essential for long-term human well-being.</data>
      <data key="d3">85</data>
    </node>
    <node id="V08">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Universities should adopt environmentally sustainable campus practices even if implementation costs increase.</data>
      <data key="d3">85</data>
    </node>
    <node id="V09">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Products should be designed to encourage reuse, repair, and recycling.</data>
      <data key="d3">85</data>
    </node>
    <node id="V10">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Consumers should consider environmental impact when purchasing products.</data>
      <data key="d3">85</data>
    </node>
    <node id="V11">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Technological innovation is essential for addressing environmental challenges.</data>
      <data key="d3">84</data>
    </node>
    <node id="V12">
      <data key="d0">V</data>
      <data key="d1">Environment</data>
      <data key="d2">Environmental sustainability should be integrated into higher education curricula.</data>
      <data key="d3">84</data>
